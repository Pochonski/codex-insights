{
  "name": "codex-insights",
  "displayName": "Codex Insights",
  "description": "Local-first Codex analytics with ChatGPT plan quotas, history, and React dashboard",
  "version": "0.4.3",
  "publisher": "codex-insights-local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexInsights.openDashboard",
        "title": "Codex Insights: Open Dashboard"
      },
      {
        "command": "codexInsights.openMiniPanel",
        "title": "Codex Insights: Open Mini Panel"
      },
      {
        "command": "codexInsights.refresh",
        "title": "Codex Insights: Refresh"
      },
      {
        "command": "codexInsights.signIn",
        "title": "Codex Insights: Sign in with ChatGPT"
      },
      {
        "command": "codexInsights.copySummary",
        "title": "Codex Insights: Copy Status Summary"
      }
    ],
    "configuration": {
      "title": "Codex Insights",
      "properties": {
        "codexInsights.sessionsPath": {
          "type": "string",
          "default": "",
          "description": "Override the Codex sessions directory; leave blank for CODEX_HOME/sessions or ~/.codex/sessions."
        },
        "codexInsights.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Refresh interval in seconds."
        },
        "codexInsights.codexExecutable": {
          "type": "string",
          "default": "codex",
          "description": "Path to Codex CLI executable (must provide app-server subcommand)."
        },
        "codexInsights.quotaRefreshSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 60,
          "description": "Refresh rate limit information via Codex App Server, in seconds."
        },
        "codexInsights.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Write anonymized local import performance diagnostics to the Codex Insights Output channel."
        },
        "codexInsights.statusBar.compact": {
          "type": "boolean",
          "default": false,
          "description": "Show compact quota percentages in the Codex Insights status bar."
        },
        "codexInsights.statusBar.showWeeklyQuota": {
          "type": "boolean",
          "default": true,
          "description": "Show the 7-day quota in the status bar and hover when available."
        },
        "codexInsights.statusBar.clickAction": {
          "type": "string",
          "enum": [
            "miniPanel",
            "dashboard"
          ],
          "default": "dashboard",
          "description": "Choose what opens when the Codex Insights status bar item is clicked."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview && npm run build:mini",
    "watch": "concurrently \"npm:build:extension -- --watch\" \"npm:build:webview -- --watch\" \"npm:build:mini -- --watch\"",
    "test": "vitest run",
    "build:e2e": "esbuild test/e2e/suite.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/e2e/suite.js",
    "test:e2e": "npm run build && npm run build:e2e && node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies",
    "benchmark": "node scripts/benchmark.mjs",
    "audit:sessions": "node scripts/audit-sessions.mjs",
    "audit:tokens": "node scripts/reconcile-tokens.mjs",
    "audit:history": "node scripts/audit-history.mjs",
    "reset:history": "node scripts/reset-local-history.mjs",
    "reset:history:execute": "node scripts/apply-local-history-reset.mjs",
    "benchmark:history": "node --expose-gc scripts/benchmark-history.mjs",
    "screenshot:demo": "npm run build:webview && node scripts/render-dashboard-demo.mjs",
    "scan:package": "node scripts/check-sensitive-files.mjs",
    "smoke:app-server": "node scripts/smoke-app-server.mjs",
    "build:extension": "esbuild src/extension/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js && esbuild src/reconciliation/historical-audit-worker.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/historical-audit-worker.js",
    "build:webview": "esbuild src/webview/dashboard.js --bundle --platform=browser --format=iife --target=es2020 --minify --outfile=media/dashboard.js",
    "build:mini": "esbuild src/webview/mini-panel.js --bundle --platform=browser --format=iife --target=es2020 --minify --outfile=media/mini-panel.js",
    "screenshot:mini": "npm run build:mini && node scripts/render-mini-demo.mjs",
    "benchmark:integrity-dashboard": "node scripts/benchmark-dashboard-integrity.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pochonski/codex-insights.git"
  }
}
